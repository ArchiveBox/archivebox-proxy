[Unit]
Description=ArchiveBox caching proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=archivebox-proxy
StateDirectoryMode=0700
WorkingDirectory=/var/lib/archivebox-proxy
# Listener addresses default to loopback; remote access needs an explicit PROXY_BIND.
ExecStart=/opt/archivebox-proxy/.venv/bin/archivebox-proxy --data /var/lib/archivebox-proxy
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
